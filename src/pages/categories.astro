---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const posts = (await getCollection('posts'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const grouped = new Map<string, typeof posts>();
for (const post of posts) {
  const categories = post.data.categories.length ? post.data.categories : ['未分类'];
  for (const category of categories) {
    grouped.set(category, [...(grouped.get(category) ?? []), post]);
  }
}
const categories = [...grouped.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh-CN'));
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---
<SiteLayout title="分类 · BH3MT 无风" description="BH3MT 无风的文章分类与归档。">
  <div class="shell archive-page">
    <header class="archive-hero">
      <span class="eyebrow">taxonomy / archive</span>
      <h1>按分类阅读</h1>
      <p>把零散的笔记放回它们应该在的位置。共 {categories.length} 个分类，{posts.length} 篇公开文章。</p>
    </header>

    <nav class="category-grid" aria-label="文章分类">
      {categories.map(([category, items]) => (
        <a class="category-card" href={`#category-${encodeURIComponent(category)}`}>
          <span class="category-index">{String(categories.findIndex(([name]) => name === category) + 1).padStart(2, '0')}</span>
          <strong>{category}</strong>
          <span>{items.length} 篇文章 →</span>
        </a>
      ))}
    </nav>

    <div class="category-sections">
      {categories.map(([category, items]) => (
        <section class="category-section" id={`category-${encodeURIComponent(category)}`}>
          <div class="section-heading">
            <div><span class="eyebrow">category</span><h2>{category}</h2></div>
            <span class="muted">{items.length} 篇</span>
          </div>
          <div class="post-list">
            {items.map((post) => (
              <article class="post-card">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <div><h3><a href={`${base}posts/${post.data.slug}/`}>{post.data.title}</a></h3></div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</SiteLayout>
