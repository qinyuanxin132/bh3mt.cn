---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const searchable = posts.map(({ data }) => [data.title, data.slug, ...data.categories, ...data.tags].join(' ').toLowerCase());
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const latestDate = posts[0]?.data.date ?? new Date();
const monthKeys = Array.from({ length: 12 }, (_, index) => {
  const date = new Date(latestDate.getFullYear(), latestDate.getMonth() - 11 + index, 1);
  return { key: `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`, label: date.toLocaleDateString('zh-CN', { month: 'short' }) };
});
const monthlyCounts = new Map(monthKeys.map(({ key }) => [key, 0]));
for (const post of posts) {
  const key = `${post.data.date.getFullYear()}-${String(post.data.date.getMonth() + 1).padStart(2, '0')}`;
  if (monthlyCounts.has(key)) monthlyCounts.set(key, (monthlyCounts.get(key) ?? 0) + 1);
}
const peakMonth = Math.max(...monthlyCounts.values(), 1);
---
<SiteLayout>
  <div class="shell">
    <section class="hero" id="about">
      <div class="hero-copy">
        <span class="eyebrow">notes / reverse / linux</span>
        <h1>把遇到的问题，<br /><span class="muted">写成下次能读懂的答案。</span></h1>
        <p>这里记录 CTF、逆向工程、Linux、编程学习，以及一些还没有被整理成答案的想法。</p>
        <div class="hero-actions">
          <a class="button primary" href={`${base}#articles`}>浏览文章</a>
          <a class="button" href="https://github.com/qinyuanxin132/bh3mt.cn" target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="hero-card" aria-label="博客状态">
        <div class="terminal-dot"><i></i><i></i><i></i></div>
        <div class="hero-card-line"><span>status</span><strong>writing</strong></div>
        <div class="hero-card-line"><span>topics</span><strong>reverse / ctf</strong></div>
        <div class="hero-card-line"><span>published</span><strong>{posts.length} notes</strong></div>
        <div class="hero-card-prompt">$ keep_learning<span>_</span></div>
      </div>
    </section>

    <section class="activity-section" aria-labelledby="activity-title">
      <div class="section-heading">
        <div><span class="eyebrow">writing rhythm</span><h2 id="activity-title">更新节奏</h2></div>
        <span class="muted">最近 12 个月</span>
      </div>
      <div class="activity-chart">
        {monthKeys.map(({ key, label }) => {
          const count = monthlyCounts.get(key) ?? 0;
          const height = count ? Math.max(12, Math.round((count / peakMonth) * 100)) : 4;
          return <div class="activity-month" title={`${key}：${count} 篇`}><div class="activity-bar-track"><div class="activity-bar" style={`height: ${height}%`}></div></div><strong>{count}</strong><span>{label}</span></div>;
        })}
      </div>
    </section>

    <section id="articles">
      <div class="section-heading">
        <div>
          <span class="eyebrow">archive</span>
          <h2>最近文章</h2>
        </div>
        <span class="muted">{posts.length} 篇公开文章</span>
      </div>
      <label class="search-box">
        <span aria-hidden="true">⌕</span>
        <input id="post-search" type="search" placeholder="搜索标题、分类或标签…" autocomplete="off" />
        <kbd>/</kbd>
      </label>
      <div class="post-list" id="post-list">
        {posts.map((post, index) => (
          <article class="post-card" data-search={searchable[index]}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <h3><a href={`${base}posts/${post.data.slug}/`}>{post.data.title}</a></h3>
              <div class="meta">
                {post.data.categories.map((category) => <span class="tag">{category}</span>)}
                {post.data.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="empty-state" id="empty-state" hidden>没有找到匹配的文章。</p>
    </section>
  </div>
  <script>
    const input = document.querySelector('#post-search');
    const cards = [...document.querySelectorAll('[data-search]')];
    const empty = document.querySelector('#empty-state');
    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !query || card.dataset.search.includes(query);
        card.hidden = !match;
        if (match) visible++;
      });
      empty.hidden = visible !== 0;
    };
    input?.addEventListener('input', filter);
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== input) {
        event.preventDefault();
        input?.focus();
      }
    });
  </script>
</SiteLayout>
