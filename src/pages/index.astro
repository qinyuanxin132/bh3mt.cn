---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const searchable = posts.map(({ data }) => [data.title, data.slug, ...data.categories, ...data.tags].join(' ').toLowerCase());
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const latestDate = posts[0]?.data.date ?? new Date();
const formatDay = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const endOfWeek = new Date(latestDate.getFullYear(), latestDate.getMonth(), latestDate.getDate());
const heatmapStart = new Date(endOfWeek);
heatmapStart.setDate(endOfWeek.getDate() - endOfWeek.getDay() - (52 * 7));
const heatmapDays = Array.from({ length: 53 * 7 }, (_, index) => {
  const date = new Date(heatmapStart);
  date.setDate(heatmapStart.getDate() + index);
  return { key: formatDay(date), label: date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }), count: 0 };
});
const dailyCounts = new Map(heatmapDays.map(({ key }) => [key, 0]));
for (const post of posts) {
  const key = formatDay(post.data.date);
  if (dailyCounts.has(key)) dailyCounts.set(key, (dailyCounts.get(key) ?? 0) + 1);
}
for (const day of heatmapDays) day.count = dailyCounts.get(day.key) ?? 0;
const heatmapWeeks = Array.from({ length: 53 }, (_, week) => heatmapDays.slice(week * 7, week * 7 + 7));
---
<SiteLayout>
  <div slot="header-search" class="header-search">
    <label class="search-box" for="post-search">
      <span aria-hidden="true">⌕</span>
      <input id="post-search" type="search" placeholder="搜索文章…" autocomplete="off" aria-label="搜索文章" />
      <kbd>/</kbd>
    </label>
    <span class="search-status" id="search-status">{posts.length} 篇</span>
    <div class="search-results" id="search-results" aria-live="polite">
      {posts.map((post, index) => <a class="search-result" data-result-search={searchable[index]} href={`${base}posts/${post.data.slug}/`}><strong>{post.data.title}</strong><span>{post.data.categories[0] ?? '未分类'} · {formatDate(post.data.date)}</span></a>)}
      <span class="search-no-result" id="search-no-result" hidden>没有找到匹配文章</span>
    </div>
  </div>
  <div class="shell">
    <section class="hero" id="about">
      <div class="hero-copy">
        <span class="eyebrow">notes / reverse / linux</span>
        <h1>把遇到的问题，<br /><span class="muted">写成下次能读懂的答案。</span></h1>
        <p>这里记录 CTF、逆向工程、Linux、编程学习，以及一些还没有被整理成答案的想法。</p>
        <div class="hero-actions">
          <a class="button primary" href={`${base}#articles`}>浏览文章</a>
          <a class="button" href="https://github.com/qinyuanxin132/bh3mt.cn" target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="hero-card" aria-label="博客状态">
        <div class="terminal-dot"><i></i><i></i><i></i></div>
        <div class="hero-card-line"><span>status</span><strong>writing</strong></div>
        <div class="hero-card-line"><span>topics</span><strong>reverse / ctf</strong></div>
        <div class="hero-card-line"><span>published</span><strong>{posts.length} notes</strong></div>
        <div class="hero-card-prompt">$ keep_learning<span>_</span></div>
      </div>
    </section>

    <section class="activity-section" aria-labelledby="activity-title">
      <div class="section-heading">
        <div><span class="eyebrow">writing rhythm</span><h2 id="activity-title">更新节奏</h2></div>
        <span class="muted">最近一年</span>
      </div>
      <div class="heatmap-wrap">
        <div class="heatmap-days" aria-hidden="true"><span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span></div>
        <div class="heatmap" aria-label="最近一年的文章更新频次">
          {heatmapWeeks.map((week) => <div class="heatmap-week">{week.map((day) => <span class={`heatmap-cell level-${Math.min(day.count, 4)}`} title={`${day.label}：${day.count} 篇`} aria-label={`${day.label}：${day.count} 篇`}></span>)}</div>)}
        </div>
      </div>
      <div class="heatmap-legend"><span>少</span><i class="level-0"></i><i class="level-1"></i><i class="level-2"></i><i class="level-3"></i><i class="level-4"></i><span>多</span></div>
    </section>

    <section id="articles">
      <div class="section-heading">
        <div>
          <span class="eyebrow">archive</span>
          <h2>最近文章</h2>
        </div>
        <span class="muted">{posts.length} 篇公开文章</span>
      </div>
      <div class="post-list" id="post-list">
        {posts.map((post, index) => (
          <article class="post-card" data-search={searchable[index]}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <h3><a href={`${base}posts/${post.data.slug}/`}>{post.data.title}</a></h3>
              <div class="meta">
                {post.data.categories.map((category) => <span class="tag">{category}</span>)}
                {post.data.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="empty-state" id="empty-state" hidden>没有找到匹配的文章。</p>
    </section>
  </div>
  <script>
    const input = document.querySelector('#post-search');
    const cards = [...document.querySelectorAll('[data-search]')];
    const empty = document.querySelector('#empty-state');
    const status = document.querySelector('#search-status');
    const results = [...document.querySelectorAll('.search-result')];
    const resultPanel = document.querySelector('#search-results');
    const noResult = document.querySelector('#search-no-result');
    const filter = () => {
      const query = input?.value.trim().toLowerCase() ?? '';
      let visible = 0;
      cards.forEach((card) => {
        const haystack = `${card.dataset.search ?? ''} ${card.textContent ?? ''}`.toLowerCase();
        const match = !query || haystack.includes(query);
        card.hidden = !match;
        if (match) visible++;
      });
      let visibleResults = 0;
      results.forEach((result) => {
        const match = !query || (result.dataset.resultSearch ?? '').includes(query);
        result.hidden = !match;
        if (match) visibleResults++;
      });
      if (empty) empty.hidden = visible !== 0;
      if (status) status.textContent = query ? `${visible} 个结果` : `${cards.length} 篇`;
      if (resultPanel) resultPanel.classList.toggle('is-open', Boolean(query));
      if (noResult) noResult.hidden = visibleResults !== 0;
    };
    input?.addEventListener('input', filter);
    input?.addEventListener('search', filter);
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== input) {
        event.preventDefault();
        input?.focus();
      }
    });
  </script>
</SiteLayout>
