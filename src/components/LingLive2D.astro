---
import { lingPresets, lingActions } from '../data/ling-live2d';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<aside class="ling-live2d" data-base={base} data-model-version="16" aria-label="泠的 Live2D 看板娘">
  <div class="ling-live2d-stage" id="ling-live2d-stage" hidden>
    <div class="ling-live2d-view">
      <span class="ling-live2d-hint" aria-hidden="true">滚轮缩放 · 双击身体进橱窗</span>
      <canvas class="ling-live2d-canvas" role="img" aria-label="泠的 Live2D 模型，可随鼠标转头，点击脸或狐耳互动，滚轮缩放，双击身体进入橱窗"></canvas>
      <img class="ling-live2d-poster" src={`${base}images/ling/ling-reading.webp`} alt="泠正在准备出来" width="640" height="800" />
      <div class="ling-live2d-notice" role="status" aria-live="polite">泠正在过来…</div>
      <button class="ling-live2d-retry" type="button" hidden>再试一次</button>
    </div>
    <div class="ling-live2d-sizebar" aria-label="尺寸与橱窗">
      <button data-ling-action="zoom-out" type="button" aria-label="缩小泠" title="缩小" disabled>−</button>
      <button data-ling-action="zoom-reset" type="button" aria-label="恢复默认尺寸" title="恢复默认尺寸" disabled><output class="ling-live2d-zoom">100%</output></button>
      <button data-ling-action="zoom-in" type="button" aria-label="放大泠" title="放大" disabled>＋</button>
      <button data-ling-action="showcase" type="button" aria-haspopup="dialog" aria-controls="ling-showcase" title="双击身体也可进入橱窗" disabled>橱窗 ↗</button>
    </div>
    <div class="ling-live2d-toolbar" aria-label="看板娘控制">
      <button class="ling-live2d-drag" type="button" title="拖动移动；方向键也可移动" aria-label="移动泠的位置">⠿ 泠</button>
      <button data-ling-action="motion" type="button" title="和泠互动" disabled>互动</button>
      <button data-ling-action="expression" type="button" title="切换泠的表情" disabled>表情</button>
      <button data-ling-action="pause" type="button" aria-pressed="false" title="暂停动作" disabled>暂停</button>
      <button data-ling-action="close" type="button" title="收起泠" aria-label="收起泠">×</button>
    </div>
    <details class="ling-live2d-settings">
      <summary>待机与动作 <span aria-hidden="true">⌃</span></summary>
      <div class="ling-live2d-settings-panel">
        <p>泠 · v16 <span>轻柔动作</span><button class="ling-live2d-settings-close" type="button" aria-label="关闭待机与动作面板" title="关闭面板">×</button></p>
        <label>待机预设<select class="ling-live2d-preset" aria-label="待机预设" disabled>{lingPresets.map(preset => <option value={preset.id}>{preset.label}</option>)}</select></label>
        <label>指定动作<select class="ling-live2d-action" aria-label="指定动作" disabled>{lingActions.map(action => <option value={action.group}>{action.label}</option>)}</select></label>
        <div class="ling-live2d-settings-buttons"><button data-ling-action="play" type="button" disabled>播放动作</button><button data-ling-action="reset-preset" type="button" disabled>恢复轻柔</button></div>
        <small>低幅度待机 · 缓慢过渡 · 预设自动记住</small>
        <output class="ling-live2d-action-status" role="status" aria-live="polite"></output>
      </div>
    </details>
  </div>
  <button class="ling-live2d-launcher" type="button" aria-expanded="false" aria-controls="ling-live2d-stage" title="展开泠的 Live2D 看板娘">
    <span aria-hidden="true">✦</span> 召唤泠
  </button>
</aside>
<dialog class="ling-showcase" id="ling-showcase" aria-labelledby="ling-showcase-title" aria-describedby="ling-showcase-help">
  <header class="ling-showcase-heading">
    <div><span class="eyebrow">LING / LIVE2D</span><h2 id="ling-showcase-title">泠的橱窗</h2></div>
    <button class="ling-showcase-close" type="button" aria-label="退出橱窗" title="退出橱窗（Esc）" autofocus>×</button>
  </header>
  <div class="ling-showcase-mount"></div>
  <p id="ling-showcase-help">滚轮或 ＋ / − 调整大小 · 点击 100% 复位 · Esc 返回桌面</p>
</dialog>
<script>
  import { initLingLive2D } from '../scripts/ling-live2d';
  initLingLive2D();
</script>
