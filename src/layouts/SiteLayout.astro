---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'BH3MT 无风', description = '记录逆向、CTF、Linux 与编程学习。' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href={base}>
          <span class="brand-mark">B</span>
          <span>BH3MT <em>无风</em></span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a href={base}>文章</a>
          <a href={`${base}categories/`}>分类</a>
          <a href={`${base}about/`}>关于</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell"><strong>BH3MT 无风</strong><span> · 用文字记录问题，用代码验证答案。</span></div>
    </footer>
    <script define:vars={{ base }}>
      document.querySelectorAll('img[src^="/upload/"]').forEach((image) => {
        image.setAttribute('src', `${base}${image.getAttribute('src').slice(1)}`);
      });
      const finePointer = matchMedia('(pointer: fine)').matches;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (finePointer && !reducedMotion) {
        const glow = document.createElement('div');
        const dot = document.createElement('div');
        glow.className = 'cursor-glow';
        dot.className = 'cursor-dot';
        document.body.append(glow, dot);
        document.body.classList.add('cursor-fx-active');
        let x = -100, y = -100, targetX = x, targetY = y;
        const move = (event) => { targetX = event.clientX; targetY = event.clientY; };
        const render = () => {
          x += (targetX - x) * .18;
          y += (targetY - y) * .18;
          glow.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          dot.style.transform = `translate3d(${targetX}px, ${targetY}px, 0)`;
          requestAnimationFrame(render);
        };
        window.addEventListener('pointermove', move, { passive: true });
        document.querySelectorAll('a, button, input, .heatmap-cell').forEach((element) => {
          element.addEventListener('pointerenter', () => glow.classList.add('is-hover'));
          element.addEventListener('pointerleave', () => glow.classList.remove('is-hover'));
        });
        render();
        document.addEventListener('pointerdown', (event) => {
          const burst = document.createElement('div');
          burst.className = 'click-burst';
          burst.style.left = `${event.clientX}px`;
          burst.style.top = `${event.clientY}px`;
          const ring = document.createElement('i');
          ring.className = 'click-ring';
          burst.append(ring);
          for (let index = 0; index < 18; index += 1) {
            const particle = document.createElement('span');
            particle.style.setProperty('--angle', `${(index / 18) * 360 + (Math.random() * 14 - 7)}deg`);
            particle.style.setProperty('--distance', `${34 + Math.random() * 32}px`);
            particle.style.setProperty('--delay', `${Math.random() * 70}ms`);
            particle.className = index % 3 === 0 ? 'is-violet' : 'is-cyan';
            burst.append(particle);
          }
          document.body.append(burst);
          window.setTimeout(() => burst.remove(), 850);
        });
      }
    </script>
  </body>
</html>
