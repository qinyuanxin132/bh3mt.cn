---
import '../styles/global.css';
import LingLive2D from '../components/LingLive2D.astro';
interface Props { title?: string; description?: string; }
const { title = 'BH3MT 无风 · 月下手记', description = '与泠一起，记录逆向、CTF、Linux 与编程学习。' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const links = [{href:base, label:'手记', en:'NOTES'}, {href:`${base}categories/`, label:'分类', en:'ARCHIVE'}, {href:`${base}skills/`, label:'能力树', en:'SKILL TREE'}, {href:`${base}ling/`, label:'泠', en:'CHARACTER'}, {href:`${base}lab/`, label:'实验室', en:'CODE LAB'}, {href:`${base}tools/`, label:'工具箱', en:'TOOLBOX'}, {href:`${base}about/`, label:'关于', en:'ABOUT'}];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101a2b" />
    <link rel="icon" type="image/webp" href={`${base}images/ling/ling-reading.webp`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href={base} aria-label="BH3MT 无风 首页">
          <span class="brand-avatar"><img src={`${base}images/ling/ling-reading.webp`} alt="" width="640" height="800" /></span>
          <span>BH3MT <em>无风</em><small>月下手记 · MOONLIT NOTES</small></span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          {links.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : link.href === base && Astro.url.pathname.startsWith(`${base}posts/`) ? 'location' : undefined}><span>{link.label}</span><small>{link.en}</small></a>)}
        </nav>
        <div class="header-search-slot"><slot name="header-search" /></div>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <div class="farewell-banner">
          <img src={`${base}images/ling/ling-farewell.webp`} alt="泠在月色下的窗边轻轻挥手" width="1536" height="1024" loading="lazy" />
          <div class="farewell-copy"><span class="eyebrow">until the next page</span><p>这一页读完了，<br />下次也来坐坐吧。</p><a href={`${base}ling/`}>认识泠 <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="footer-inner"><div><strong>BH3MT 无风</strong><span> · 记录问题，也收藏月光。</span></div><span>原创角色 · 泠 <i aria-hidden="true">✦</i> 用文字记录，用代码验证</span></div>
      </div>
    </footer>
    <LingLive2D />
    <button class="back-top" type="button" aria-label="回到页面顶部" hidden>↑<small>TOP</small></button>
    <script define:vars={{ base }}>
      document.querySelectorAll('img[src^="/upload/"]').forEach((image) => {
        image.setAttribute('src', `${base}${image.getAttribute('src').slice(1)}`);
      });
      const header = document.querySelector('.site-header');
      const updateHeaderHeight = () => {
        if (header) document.documentElement.style.setProperty('--header-height', `${header.getBoundingClientRect().height}px`);
      };
      if (header) new ResizeObserver(updateHeaderHeight).observe(header);
      updateHeaderHeight();
      const topButton = document.querySelector('.back-top');
      const updateTop = () => { if (topButton) topButton.hidden = window.scrollY < 600; };
      window.addEventListener('scroll', updateTop, { passive: true });
      topButton?.addEventListener('click', () => window.scrollTo({top:0, behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'}));
      updateTop();
    </script>
  </body>
</html>
